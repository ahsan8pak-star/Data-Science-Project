digraph DFA {
    rankdir = LR;
    node [shape = circle; fontname = "Helvetica";];
    edge [fontname = "Helvetica";];
    
    start [shape = point;];
    start -> q0;
    
    q2 [shape = doublecircle;];
    
    q0 -> q1 [label = "a";];
    q1 -> q2 [label = "a";];
    q1 -> q1 [label = "b";];
    q1 -> q0 [label = "c";];
    q2 -> q0 [label = "b";];
    q2 -> q0 [label = "c";];
}