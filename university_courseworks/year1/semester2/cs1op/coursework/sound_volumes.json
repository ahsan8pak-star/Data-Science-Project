{
  "description": "CS1OP sound effect levels, measured before and after range compression, so the Python and Java copies can be compared and kept in step.",
  "script": "scripts/normalize_sound_volumes.py",
  "method": {
    "approach": "range compression, one flat gain per clip",
    "level_metric": "gated RMS: RMS of the samples within 50 dB of the clip's own peak",
    "level_metric_rationale": "plain RMS is dominated by silence. 'Main Menu GUI.wav' is 88% silence around a short burst, so its plain RMS (-33.50 dBFS) is the lowest in the folder while its peak is -3.50 dBFS. Ranking on plain RMS asks for +25.8 dB on that clip, which only a hard limiter could deliver; on the gated metric it sits at -24.88 dBFS and needs a sane gain",
    "floor_ratio": 0.2,
    "floor_ratio_rationale": "the user asked for the quietest clip to sit at 20% of the loudest, with 15% as the point below which a clip counts as too quiet",
    "ceiling_dbfs": -1.0,
    "limiter": "tanh soft knee at 80% of the ceiling, so peaks bend instead of clipping flat",
    "gain_solved_after_limiting": "the limiter gives back part of any boost, so the gain is bisected until the measured level lands on the target rather than computed up front",
    "why_not_one_flat_gain": "a single gain large enough to lift the quietest clip to 20% of the loudest pushes the peaks of every clip past full scale, which flattens them all to the same level and loses the differences"
  },
  "directories": [
    {
      "language": "java",
      "path": "java/resources/sound_effects/",
      "role": "master; written first"
    },
    {
      "language": "python",
