{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PostgreSQL: Run SQL file (psql)",
            "type": "shell",
            "command": "psql",
            "args": [
                "-f",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Sync: Update Requirements (requirements_sync.py)",
            "type": "shell",
            "command": "venv-win\\Scripts\\python.exe requirements\\requirements_sync.py",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}


