for row in rows:
    print("| " + row.ljust(width) + " |")
print("+" + ("-" * (width + 2)) + "+")

# a node's degree is the number of incident edges, i.e. the length of its neighbour list plus one when a self-loop exists
degree_sum = 0

for node, val in neighbours.items():
    if node in val:
        degree_sum += len(val) + 1 # + 1 -> self-loop
    
    else:
        degree_sum += len(val)

print("\n=======================================")
print(f'{f"Sum of degrees (easy rule): {degree_sum}":^40}') # :^ -> centre alignment
print("=======================================\n")









