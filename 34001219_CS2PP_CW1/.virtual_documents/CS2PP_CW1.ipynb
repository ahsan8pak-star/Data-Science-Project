# 1.8 - Evaluate converters on synthetic topologies
import timeit

# TUI box: one summary line per converter/topology/size.
rows = []

for topology in ("star", "chain", "dense"):
    for n in (10, 50, 100, 500):
        make = network_function_generator(topology, n)
        synth_edges = make()

        for name in ("my", "g", "h"):
            if name != "my":
                module = candidates
            else:
                module = network

            fn = getattr(module, f"edge_to_neighbour_list_{name}")

            # Time the function with 5 loops and 3 repeats, then check correctness against the reference implementation
            times = timeit.repeat(lambda: fn(synth_edges), number = 5, repeat = 3)
            t = min(times) / 5
            got = fn(synth_edges)
            ref_nb = network.edge_to_neighbour_list_my(synth_edges)
            ok = set(got) == set(ref_nb)

            for k in ref_nb:
                if set(got[k]) != set(ref_nb[k]):
                    ok = False
                    break
            rows.append(f"{topology:6s} n = {n:4d} {name}: {t:.4f}s correct = {ok}")

width = 0

for row in rows:
    if len(row) > width:
        width = len(row)

# + 2 -> (2 x "+") or "| " or " |"
print("+" + ("-" * (width + 2)) + "+")
for row in rows:
    print("| " + row.ljust(width) + " |")
print("+" + ("-" * (width + 2)) + "+")





















